# LLM Provider Configuration
# Choose either 'gemini' or 'openai'
LLM_PROVIDER=gemini

# Google Gemini API Key (Recommended - used with gemini-2.5-flash)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional alternative - used with gpt-4o-mini)
# OPENAI_API_KEY=your_openai_api_key_here
